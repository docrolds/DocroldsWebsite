# Backend Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit real credentials to git

PORT=3000
NODE_ENV=development

# Database (replace with your actual database URL)
DATABASE_URL=postgresql://user:password@localhost:5432/docrolds

# Authentication
JWT_SECRET=generate-a-random-64-char-string
JWT_CUSTOMER_SECRET=generate-another-random-64-char-string
ADMIN_USERNAME=admin@yourdomain.com
ADMIN_PASSWORD=use-a-strong-password

# Square Payment (use sandbox for testing)
SQUARE_APPLICATION_ID=sandbox-your-app-id
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASS=your-gmail-app-password

# SendGrid (Alternative - Recommended for production)
SENDGRID_API_KEY=SG.your-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your App Name

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Download Settings
DOWNLOAD_LINK_EXPIRY_DAYS=7

# Cron Job Secret
CRON_SECRET=generate-random-string-for-cron
