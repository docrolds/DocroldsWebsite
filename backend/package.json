{
  "name": "docrolds-api",
  "version": "1.0.0",
  "description": "Doc Rolds API Server",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "start:migrate": "npx prisma migrate deploy && node dist/index.js",
    "start:legacy": "npx prisma migrate deploy && node server.cjs",
    "dev": "ts-node src/index.ts",
    "dev:legacy": "node server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "postinstall": "prisma generate",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.10.5",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "prisma": "5.22.0",
    "sharp": "^0.32.6",
    "square": "^43.2.1",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.6",
    "@types/nodemailer": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
