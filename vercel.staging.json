{
  "build": {
    "env": {
      "VITE_API_URL": "https://docrolds-staging-api.onrender.com/api",
      "VITE_ENV": "staging"
    }
  },
  "outputDirectory": "frontend/dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
